# ==============================================================================
# LunarNavigator - Root .gitignore
# Combined Unity 6 (HDRP) + Python (FastAPI/Science Engine)
# NASA Space Apps Challenge
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Unity Editor Reproducible Caches & Temporary Artifacts
# ------------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity Asset Cache / Package Cache / Extracted Assets
AssetBundles/
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# Unity Profiler / Crashlytics / Diagnostics
crashlytics-build.properties
sysinfo.txt
*.pidb.meta

# Standalone builds / executable packages (uploaded via GitHub Releases)
*.apk
*.aab
*.unitypackage
*.app

# ------------------------------------------------------------------------------
# 2. IDE, Editor & Solution Project Files (Unity Auto-Generated)
# ------------------------------------------------------------------------------
.vs/
.vsconfig
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Visual Studio Code (preserve team workspace configs if present)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 3. Python Backend (FastAPI, Science Engine & Analysis)
# ------------------------------------------------------------------------------
# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Bytecode, compilation and runtime cache
__pycache__/
*.py[cod]
*$py.class

# Pytest, coverage and temporary test artifacts
.pytest_cache/
pytest-cache-files-*/
.coverage
htmlcov/
.tox/
.nox/

# Python build and distribution
dist/
build/
*.egg-info/
.eggs/

# NASA API runtime cache, temporary runs and diagnostic outputs
backend/data/api/
backend/data/cache/
backend/data/runs/
backend/data/horizons_output/

# ------------------------------------------------------------------------------
# 4. Local Scratch, Temporary, and Archive Files
# ------------------------------------------------------------------------------
/tmp/
/Screenshots.zip

# ------------------------------------------------------------------------------
# 5. Operating System Junk
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ------------------------------------------------------------------------------
# 6. Sensitive Files & Local Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# ------------------------------------------------------------------------------
# 7. CRITICAL PROJECT ASSET & DOCUMENT PROTECTIONS (Explicit Whitelist)
# ------------------------------------------------------------------------------
# Ensure Unity Assets, Scenes, Shaders, Models, Textures, and Scripts are tracked
!Assets/**
!Assets/LunarNavigator/Generated/**
!*.meta

# Ensure Unity Project Settings and Package Manager configs are tracked
!Packages/manifest.json
!Packages/packages-lock.json
!ProjectSettings/**

# Ensure Scientific Backend sources, tests, contract docs, and datasets are tracked
!backend/science/**
!backend/src/**
!backend/tests/**
!backend/data/sites.json
!backend/data/horizons_inbox/**
!backend/requirements.txt
!backend/docs/**

# Ensure Team Documentation, Scientific References, Proposal & Manuals are tracked
!docs/**
!Documentation/**

